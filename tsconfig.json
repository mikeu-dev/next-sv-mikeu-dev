{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"incremental": true,
		"tsBuildInfoFile": ".svelte-kit/tsconfig.tsbuildinfo"
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"src/routes/.well-known/**/*.ts"
	],
	"exclude": [
		"node_modules",
		".vercel",
		"build",
		"dist",
		"static",
		"src/lib/server/scripts/**",
		"src/service-worker"
	]
}
